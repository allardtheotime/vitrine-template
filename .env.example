# Variables d'environnement à configurer dans Vercel (Project Settings → Environment Variables)
# pour chaque projet client — jamais commitées dans le repo.

# Clé API Resend (https://resend.com) utilisée par api/contact.ts pour envoyer les emails
# du formulaire de contact. En démo : la clé « démo » partagée. À la mise en ligne : une
# clé dédiée au client, limitée à son domaine (Sending access).
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire de contact (ex. l'email pro de Théotime,
# ou celui du client une fois le site livré).
CONTACT_TO_EMAIL=

# Nom affiché dans l'objet de l'email reçu — optionnel, retombe sur "Site vitrine" si absent.
SITE_NAME=

# Expéditeur des emails, sur le domaine du client vérifié dans Resend (ex. contact@lilotpates.be).
# Optionnel : sans domaine vérifié, retombe sur onboarding@resend.dev (sandbox, n'écrit qu'au
# titulaire du compte Resend).
CONTACT_FROM_EMAIL=
