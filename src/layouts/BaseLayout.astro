---
import '../styles/global.css';
import DemoNotice from '../components/ui/DemoNotice.astro';

interface Props {
  title: string;
  description?: string;
  siteName: string;
  theme: {
    primary: string;
    secondary: string;
    font: string;
  };
  isDemo?: boolean;
}

const { title, description = '', siteName, theme, isDemo = false } = Astro.props;
const pageTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={`https://fonts.googleapis.com/css2?family=${theme.font.replace(' ', '+')}:wght@400;500;600;700&display=swap`}
      rel="stylesheet"
    />
    <style define:vars={{ colorPrimary: theme.primary, colorSecondary: theme.secondary, fontBody: theme.font }}>
      :root {
        --color-primary: var(--colorPrimary);
        --color-secondary: var(--colorSecondary);
        --font-body: var(--fontBody), system-ui, sans-serif;
      }
    </style>
  </head>
  <body>
    <slot />
    <DemoNotice isDemo={isDemo} />
  </body>
</html>
