---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import DemoNotice from '../components/ui/DemoNotice.astro';
import '../styles/global.css';

export interface Props {
  siteName: string;
  tagline: string;
  primaryColor: string;
  secondaryColor: string;
  fontFamily: string;
  navLinks: { label: string; href: string }[];
  phone?: string;
  email?: string;
  address?: string;
  legalName?: string;
  isDemo?: boolean;
}

const {
  siteName,
  tagline,
  primaryColor,
  secondaryColor,
  fontFamily,
  navLinks,
  phone,
  email,
  address,
  legalName,
  isDemo = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteName} — {tagline}</title>
    <meta name="description" content={tagline} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={siteName} />
    <meta property="og:description" content={tagline} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style define:vars={{ colorPrimary: primaryColor, colorSecondary: secondaryColor, fontFamily }}>
      :root {
        --color-primary: var(--colorPrimary);
        --color-secondary: var(--colorSecondary);
        --font-family: var(--fontFamily);
      }
    </style>
  </head>
  <body class="text-gray-900 antialiased">
    <Navbar siteName={siteName} links={navLinks} ctaText="Devis gratuit" ctaHref="#contact" />
    <main>
      <slot />
    </main>
    <Footer siteName={siteName} phone={phone} email={email} address={address} legalName={legalName} />
    <DemoNotice isDemo={isDemo} />
  </body>
</html>
