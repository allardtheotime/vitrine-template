---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  site: {
    name: string;
    phone: string;
    email: string;
    address: string;
    hours: string;
    siret: string;
    tagline: string;
  };
  theme: {
    primary: string;
    secondary: string;
    font: string;
  };
}

const { title, description, site, theme } = Astro.props;
---

<BaseLayout title={title} description={description} siteName={site.name} theme={theme}>
  <Navbar siteName={site.name} phone={site.phone} />
  <main>
    <slot />
  </main>
  <Footer site={site} />
</BaseLayout>
