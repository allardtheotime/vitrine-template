---
import content from '../content.json';
import PageLayout from '../layouts/PageLayout.astro';
import SectionWrapper from '../components/ui/SectionWrapper.astro';

const { site, theme } = content;
const isDemo = Boolean((content as { meta?: { is_demo?: boolean } }).meta?.is_demo);

interface LegalSite {
  legal_name?: string;
  legal_form?: string;
  bce_number?: string;
  vat_number?: string;
  address?: string;
  phone?: string;
  email?: string;
  regulated_profession?: boolean;
  regulatory_authority?: string;
  license_number?: string;
}

const legalSite = site as LegalSite;
const FALLBACK = 'Information à compléter';
const field = (value?: string) => (value && value.trim() !== '' ? value : FALLBACK);
const isRegulatedProfession = legalSite.regulated_profession === true;
---

<PageLayout
  title="Mentions légales"
  description={`Mentions légales de ${site.name}`}
  site={site}
  theme={theme}
  isDemo={isDemo}
>
  <SectionWrapper bg="white">
    <div class="max-w-3xl mx-auto prose prose-gray">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-8">Mentions légales</h1>

      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Éditeur du site</h2>
        <p class="text-gray-600 leading-relaxed">
          Raison sociale : <strong>{field(legalSite.legal_name)}</strong><br />
          Forme juridique : {field(legalSite.legal_form)}<br />
          Numéro BCE : {field(legalSite.bce_number)}<br />
          Numéro de TVA : {field(legalSite.vat_number)}<br />
          Adresse : {field(legalSite.address)}<br />
          Téléphone : {legalSite.phone && legalSite.phone.trim() !== ''
            ? <a href={`tel:${legalSite.phone.replace(/\s/g, '')}`} class="text-primary hover:underline">{legalSite.phone}</a>
            : FALLBACK}<br />
          Email : {legalSite.email && legalSite.email.trim() !== ''
            ? <a href={`mailto:${legalSite.email}`} class="text-primary hover:underline">{legalSite.email}</a>
            : FALLBACK}
        </p>
      </section>

      {isRegulatedProfession && (
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-800 mb-3">Autorité de tutelle</h2>
          <p class="text-gray-600 leading-relaxed">
            Autorité de tutelle : {field(legalSite.regulatory_authority)}<br />
            Numéro d'agrément : {field(legalSite.license_number)}
          </p>
        </section>
      )}

      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Hébergeur</h2>
        <p class="text-gray-600 leading-relaxed">
          Hébergeur : Netlify
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Propriété intellectuelle</h2>
        <p class="text-gray-600 leading-relaxed">
          L'ensemble des contenus présents sur ce site (textes, images, logos) est la propriété exclusive de {site.name},
          sauf mentions contraires. Toute reproduction, même partielle, est interdite sans autorisation préalable.
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Données personnelles</h2>
        <p class="text-gray-600 leading-relaxed">
          Les informations recueillies via le formulaire de contact sont utilisées uniquement pour répondre à vos demandes.
          Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression de vos données.
          Pour exercer ces droits, contactez-nous à l'adresse : <a href={`mailto:${site.email}`} class="text-primary hover:underline">{site.email}</a>.
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Cookies</h2>
        <p class="text-gray-600 leading-relaxed">
          Ce site n'utilise pas de cookies de traçage ou de cookies tiers à des fins publicitaires.
        </p>
      </section>

      <div class="mt-10">
        <a href="/" class="text-primary font-medium hover:underline">&larr; Retour à l'accueil</a>
      </div>
    </div>
  </SectionWrapper>
</PageLayout>
