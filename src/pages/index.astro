---
import content from '../content.json';
import PageLayout from '../layouts/PageLayout.astro';
import SectionRenderer, { type Section } from '../components/SectionRenderer.astro';

const { site, theme, sections, navigation, mode } = content;
const isDemo = Boolean((content as { meta?: { is_demo?: boolean } }).meta?.is_demo);

const pageSections: Section[] = [
  sections.hero.visible && {
    type: 'hero' as const,
    title: sections.hero.title,
    subtitle: sections.hero.subtitle,
    cta_text: sections.hero.cta_text,
    cta_link: sections.hero.cta_link,
    bg_image: sections.hero.bg_image,
  },
  sections.services.visible && {
    type: 'services' as const,
    title: sections.services.title,
    items: sections.services.items,
  },
  sections.about.visible && {
    type: 'about' as const,
    title: sections.about.title,
    text: sections.about.text,
    image: sections.about.image,
    stats: sections.about.stats,
  },
  sections.testimonials.visible && {
    type: 'testimonials' as const,
    items: sections.testimonials.items,
  },
  sections.cta.visible && {
    type: 'cta' as const,
    title: sections.cta.title,
    subtitle: sections.cta.subtitle,
    button_text: sections.cta.button_text,
  },
  sections.contact.visible && {
    type: 'contact' as const,
    web3forms_key: sections.contact.web3forms_key,
    email: site.email,
    phone: site.phone,
    address: site.address,
    hours: site.hours,
  },
].filter((section): section is Section => Boolean(section));
---

<PageLayout
  title={site.tagline}
  description={`${site.name} – ${site.tagline}`}
  site={site}
  theme={theme}
  isDemo={isDemo}
  navigation={navigation}
  mode={mode}
>
  <SectionRenderer sections={pageSections} />
</PageLayout>
