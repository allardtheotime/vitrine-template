---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Services from '../components/sections/Services.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Contact from '../components/sections/Contact.astro';
import content from '../content-draft.json';

const { site, theme, sections, meta } = content;

// Nav : une entrée par section générable visible + Contact, toujours présent.
const sectionLabels: Record<string, string> = {
  about: 'À propos',
  services: 'Services',
  testimonials: 'Avis',
};

const navLinks = [
  ...(['about', 'services', 'testimonials'] as const)
    .filter((key) => sections[key]?.visible)
    .map((key) => ({ label: sectionLabels[key], href: `#${key}` })),
  { label: 'Contact', href: '#contact' },
];
---

<BaseLayout
  siteName={site.name}
  tagline={site.tagline}
  primaryColor={theme.primary}
  secondaryColor={theme.secondary}
  fontFamily={theme.font}
  navLinks={navLinks}
  phone={site.phone}
  email={site.email}
  address={site.address}
  legalName={site.legal_name}
  isDemo={meta.is_demo}
>
  {sections.hero?.visible && (
    <Hero
      title={sections.hero.title}
      subtitle={sections.hero.subtitle}
      ctaText={sections.hero.cta_text}
      ctaLink={sections.hero.cta_link}
      image={sections.hero.image}
    />
  )}

  {sections.about?.visible && (
    <About
      title={sections.about.title}
      subtitle={sections.about.subtitle}
      text={sections.about.text}
      image={sections.about.image}
      stats={sections.about.stats}
    />
  )}

  {sections.services?.visible && (
    <Services
      title={sections.services.title}
      subtitle={sections.services.subtitle}
      items={sections.services.items}
    />
  )}

  {sections.testimonials?.visible && sections.testimonials.items?.length > 0 && (
    <Testimonials title={sections.testimonials.title} items={sections.testimonials.items} />
  )}

  <Contact phone={site.phone} email={site.email} address={site.address} hours={site.hours} />
</BaseLayout>
