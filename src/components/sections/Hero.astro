---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  subtitle: string;
  cta_text: string;
  cta_link: string;
  bg_image?: string;
}

const { title, subtitle, cta_text, cta_link, bg_image = '' } = Astro.props;
---

<section
  class="relative flex items-center justify-center min-h-[80vh] bg-gray-900 text-white overflow-hidden"
  aria-label="Bannière principale"
>
  <!-- Image de fond (optionnelle) -->
  {bg_image && (
    <img
      src={bg_image}
      alt="Bannière hero"
      class="absolute inset-0 w-full h-full object-cover opacity-30"
    />
  )}

  <!-- Overlay dégradé -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/90 to-gray-900/80" aria-hidden="true"></div>

  <!-- Contenu -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
      {title}
    </h1>
    <p class="text-lg sm:text-xl text-gray-200 mb-10 max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>
    <Button href={cta_link} variant="secondary" text={cta_text} class="text-base px-8 py-4" />
  </div>
</section>
