---
import Button from '../ui/Button.astro';

export interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  image?: string;
  imageAlt?: string;
}

const { title, subtitle, ctaText, ctaLink = '/#contact', image, imageAlt } = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--color-bg)]">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 md:grid-cols-2 md:py-28 lg:px-8">
    <div>
      <h1 class="text-[var(--color-text)]">{title}</h1>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
      {ctaText && (
        <div class="mt-8">
          <Button href={ctaLink} size="lg">{ctaText}</Button>
        </div>
      )}
    </div>

    {image && (
      <img
        src={image}
        alt={imageAlt ?? title}
        loading="eager"
        class="w-full rounded-2xl object-cover shadow-lg"
      />
    )}
  </div>
</section>
