---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Badge from '../ui/Badge.astro';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  text: string;
  image?: string;
  stats: Stat[];
}

const { title, text, image = '', stats } = Astro.props;
---

<SectionWrapper id="about" bg="white">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <!-- Texte -->
    <div>
      <Badge text="À propos" variant="secondary" />
      <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900 mb-6">{title}</h2>
      <p class="text-gray-600 leading-relaxed text-lg mb-8">{text}</p>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-4">
        {stats.map(stat => (
          <div class="text-center p-4 bg-gray-50 rounded-xl">
            <div class="text-2xl sm:text-3xl font-bold text-primary">{stat.value}</div>
            <div class="text-xs sm:text-sm text-gray-500 mt-1 leading-tight">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Image ou placeholder -->
    <div class="relative">
      {image ? (
        <img
          src={image}
          alt="À propos de l'entreprise"
          class="w-full h-80 lg:h-96 object-cover rounded-2xl shadow-lg"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-80 lg:h-96 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-2xl flex items-center justify-center border-2 border-dashed border-primary/30" aria-hidden="true">
          <div class="text-center text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm font-medium">Image à ajouter</p>
          </div>
        </div>
      )}
    </div>
  </div>
</SectionWrapper>
