---
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  text: string;
  image?: string;
  stats?: { value: string; label: string }[];
}

const { title, subtitle, text, image, stats = [] } = Astro.props;
---

<SectionWrapper id="about">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-gray-900">{title}</h2>
      {subtitle && <p class="mt-2 text-lg text-gray-500">{subtitle}</p>}
      <p class="mt-4 text-gray-600">{text}</p>

      {stats.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3">
          {stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="text-2xl font-bold text-primary">{stat.value}</dd>
              <p class="text-sm text-gray-500">{stat.label}</p>
            </div>
          ))}
        </dl>
      )}
    </div>

    {image && (
      <img src={image} alt={title} loading="lazy" class="w-full rounded-2xl object-cover shadow-md" />
    )}
  </div>
</SectionWrapper>
