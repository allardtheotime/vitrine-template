---
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  text: string;
  image?: string;
  imageAlt?: string;
  stats?: { value: string; label: string }[];
}

const { title, subtitle, text, image, imageAlt, stats = [] } = Astro.props;
---

<SectionWrapper id="about">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-[var(--color-text)]">{title}</h2>
      {subtitle && <p class="mt-2 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
      <p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)]">{text}</p>

      {stats.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3">
          {stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="text-2xl font-bold text-primary">{stat.value}</dd>
              <p class="text-sm text-[var(--color-text-muted)]">{stat.label}</p>
            </div>
          ))}
        </dl>
      )}
    </div>

    {image && (
      <img src={image} alt={imageAlt ?? title} loading="lazy" class="w-full rounded-2xl object-cover shadow-md" />
    )}
  </div>
</SectionWrapper>
