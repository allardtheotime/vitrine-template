---
// Rendue automatiquement à partir de site.* (jamais une entrée dans sections{}).
// Repli sur les coordonnées manquantes : cf. règle dans design-site-vitrine —
// aucun texte "à compléter" visible, on masque simplement la ligne concernée.
import Button from '../ui/Button.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  phone?: string;
  email?: string;
  address?: string;
  hours?: string;
}

const { phone, email, address, hours } = Astro.props;
---

<SectionWrapper id="contact" bg="bg-gray-50">
  <div class="grid gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-gray-900">Contact</h2>
      <p class="mt-2 text-gray-600">Une question, un projet ? Écrivez-nous, nous répondons rapidement.</p>

      <dl class="mt-6 space-y-2 text-sm text-gray-700">
        {phone && (
          <div>
            <dt class="sr-only">Téléphone</dt>
            <dd><a href={`tel:${phone.replace(/\s+/g, '')}`} class="hover:text-primary">{phone}</a></dd>
          </div>
        )}
        {email && (
          <div>
            <dt class="sr-only">Email</dt>
            <dd><a href={`mailto:${email}`} class="hover:text-primary">{email}</a></dd>
          </div>
        )}
        {address && (
          <div>
            <dt class="sr-only">Adresse</dt>
            <dd>{address}</dd>
          </div>
        )}
        {hours && (
          <div>
            <dt class="sr-only">Horaires</dt>
            <dd>{hours}</dd>
          </div>
        )}
      </dl>
    </div>

    <form id="contact-form" class="space-y-4 rounded-xl bg-white p-6 shadow-sm">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Nom</label>
        <input
          id="name" name="name" type="text" required
          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input
          id="email" name="email" type="email" required
          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
        <textarea
          id="message" name="message" required rows="4"
          class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        ></textarea>
      </div>

      <Button type="submit" class="w-full">Envoyer</Button>

      <p id="contact-form-success" role="status" class="hidden text-sm text-green-600">
        Message envoyé, merci — nous revenons vers vous rapidement.
      </p>
      <p id="contact-form-error" role="alert" class="hidden text-sm text-red-600">
        Une erreur est survenue, réessayez ou contactez-nous directement.
      </p>
    </form>
  </div>
</SectionWrapper>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('contact-form-success');
  const errorMsg = document.getElementById('contact-form-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error('request failed');

      successMsg?.classList.remove('hidden');
      form.reset();
    } catch {
      errorMsg?.classList.remove('hidden');
    }
  });
</script>
