---
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  items: { icon: string; title: string; description: string }[];
}

const { title, subtitle, items } = Astro.props;
---

<SectionWrapper id="services" bg="bg-gray-50">
  <div class="text-center">
    <h2 class="text-3xl font-bold text-gray-900">{title}</h2>
    {subtitle && <p class="mt-2 text-lg text-gray-500">{subtitle}</p>}
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <div class="rounded-xl bg-white p-6 shadow-sm transition-colors hover:shadow-md">
        <span class="text-3xl" aria-hidden="true">{item.icon}</span>
        <h3 class="mt-4 text-lg font-semibold text-gray-900">{item.title}</h3>
        <p class="mt-2 text-sm text-gray-600">{item.description}</p>
      </div>
    ))}
  </div>
</SectionWrapper>
