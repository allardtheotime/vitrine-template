---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Badge from '../ui/Badge.astro';

interface ServiceItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  items: ServiceItem[];
}

const { title, items } = Astro.props;
---

<SectionWrapper id="services" bg="gray">
  <div class="text-center mb-12">
    <Badge text="Nos services" variant="primary" />
    <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900">{title}</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {items.map(item => (
      <article class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
        <div class="text-4xl mb-4" aria-hidden="true">{item.icon}</div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">{item.title}</h3>
        <p class="text-gray-600 leading-relaxed">{item.description}</p>
      </article>
    ))}
  </div>
</SectionWrapper>
