---
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  subtitle: string;
  button_text: string;
}

const { title, subtitle, button_text } = Astro.props;
---

<section class="bg-primary text-white py-16 md:py-20" aria-label="Appel à l'action">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4">{title}</h2>
    <p class="text-lg text-blue-100 mb-8 max-w-xl mx-auto">{subtitle}</p>
    <Button href="#contact" variant="secondary" text={button_text} class="text-base px-8 py-4" />
  </div>
</section>
