---
import SectionWrapper from '../ui/SectionWrapper.astro';
import Badge from '../ui/Badge.astro';

interface TestimonialItem {
  name: string;
  text: string;
  rating: number;
}

interface Props {
  items: TestimonialItem[];
}

const { items } = Astro.props;
---

<SectionWrapper id="testimonials" bg="gray">
  <div class="text-center mb-12">
    <Badge text="Témoignages" variant="primary" />
    <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-gray-900">Ce que disent nos clients</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {items.map(item => (
      <blockquote class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100 flex flex-col">
        <!-- Étoiles -->
        <div class="flex gap-1 mb-4" aria-label={`Note : ${item.rating} sur 5`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class={`h-5 w-5 ${i < item.rating ? 'text-secondary' : 'text-gray-200'}`}
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>

        <!-- Texte -->
        <p class="text-gray-600 leading-relaxed flex-1 mb-6">"{item.text}"</p>

        <!-- Auteur -->
        <footer class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm" aria-hidden="true">
            {item.name.charAt(0)}
          </div>
          <cite class="font-semibold text-gray-900 not-italic">{item.name}</cite>
        </footer>
      </blockquote>
    ))}
  </div>
</SectionWrapper>
