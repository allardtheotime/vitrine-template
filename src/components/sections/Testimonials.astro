---
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title?: string;
  items: { name: string; text: string; rating: number }[];
}

const { title, items } = Astro.props;
---

<SectionWrapper id="testimonials">
  {title && (
    <h2 class="text-center text-3xl font-bold text-gray-900">{title}</h2>
  )}

  <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <div class="rounded-xl border border-gray-100 p-6 shadow-sm">
        <div class="flex gap-0.5 text-secondary" aria-label={`Note : ${item.rating} sur 5`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <span aria-hidden="true">{i < item.rating ? '★' : '☆'}</span>
          ))}
        </div>
        <p class="mt-3 text-sm text-gray-700">&ldquo;{item.text}&rdquo;</p>
        <p class="mt-4 text-sm font-semibold text-gray-900">{item.name}</p>
      </div>
    ))}
  </div>
</SectionWrapper>
