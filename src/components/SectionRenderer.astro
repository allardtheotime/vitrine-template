---
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import About from './sections/About.astro';
import Testimonials from './sections/Testimonials.astro';
import CTABanner from './sections/CTABanner.astro';
import Contact from './sections/Contact.astro';

interface HeroSection {
  type: 'hero';
  title: string;
  subtitle: string;
  cta_text: string;
  cta_link: string;
  bg_image?: string;
}

interface ServicesSection {
  type: 'services';
  title: string;
  items: { icon: string; title: string; description: string }[];
}

interface AboutSection {
  type: 'about';
  title: string;
  text: string;
  image?: string;
  stats?: { value: string; label: string }[];
}

interface TestimonialsSection {
  type: 'testimonials';
  items: { name: string; text: string; rating: number }[];
}

interface CtaSection {
  type: 'cta';
  title: string;
  subtitle: string;
  button_text: string;
}

interface ContactSection {
  type: 'contact';
  web3forms_key: string;
  email: string;
  phone: string;
  address: string;
  hours: string;
}

export type Section = HeroSection | ServicesSection | AboutSection | TestimonialsSection | CtaSection | ContactSection;

interface Props {
  sections?: Section[];
}

const { sections = [] } = Astro.props;
---

{sections.map((section) => {
  switch (section.type) {
    case 'hero':
      return (
        <Hero
          title={section.title}
          subtitle={section.subtitle}
          cta_text={section.cta_text}
          cta_link={section.cta_link}
          bg_image={section.bg_image}
        />
      );
    case 'services':
      return <Services title={section.title} items={section.items} />;
    case 'about':
      return (
        <About
          title={section.title}
          text={section.text}
          image={section.image}
          stats={section.stats}
        />
      );
    case 'testimonials':
      return <Testimonials items={section.items} />;
    case 'cta':
      return (
        <CTABanner
          title={section.title}
          subtitle={section.subtitle}
          button_text={section.button_text}
        />
      );
    case 'contact':
      return (
        <Contact
          web3forms_key={section.web3forms_key}
          email={section.email}
          phone={section.phone}
          address={section.address}
          hours={section.hours}
        />
      );
    default:
      return null;
  }
})}
