---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  text: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  text,
} = Astro.props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
}[variant];
---

{href ? (
  <a href={href} class={`${variantClass} ${className}`}>
    {text}
  </a>
) : (
  <button type={type} class={`${variantClass} ${className}`}>
    {text}
  </button>
)}
