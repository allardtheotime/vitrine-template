---
export interface Props {
  id?: string;
  bg?: 'bg-white' | 'bg-gray-50';
  class?: string;
}

const { id, bg = 'bg-white', class: className = '' } = Astro.props;
---

<section id={id} class={`${bg} py-16 md:py-24 ${className}`}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
