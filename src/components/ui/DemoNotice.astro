---
interface Props {
  isDemo?: boolean;
}

const { isDemo = false } = Astro.props;
---

{isDemo && (
  <>
    <div
      id="demo-notice"
      class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-gray-900/60"
      role="dialog"
      aria-modal="true"
      aria-labelledby="demo-notice-title"
    >
      <div class="bg-white rounded-2xl shadow-lg max-w-md w-full p-6 sm:p-8">
        <h2 id="demo-notice-title" class="text-lg font-bold text-gray-900 mb-3">
          Aperçu de démonstration
        </h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-6">
          Ceci est un aperçu généré automatiquement à titre de démonstration. Certaines
          informations (textes, horaires, avis...) sont fictives et seront remplacées par les
          vraies données avant la mise en ligne définitive.
        </p>
        <button id="demo-notice-dismiss" type="button" class="btn-primary w-full text-sm py-3">
          J'ai compris
        </button>
      </div>
    </div>

    <script>
      const STORAGE_KEY = 'demo-notice-dismissed';
      const notice = document.getElementById('demo-notice');

      if (notice) {
        if (sessionStorage.getItem(STORAGE_KEY) === '1') {
          notice.remove();
        } else {
          document.getElementById('demo-notice-dismiss')?.addEventListener('click', () => {
            sessionStorage.setItem(STORAGE_KEY, '1');
            notice.remove();
          });
        }
      }
    </script>
  </>
)}
