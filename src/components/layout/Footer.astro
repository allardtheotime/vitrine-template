---
// Coordonnées non fabricables (téléphone, email) : ne jamais afficher de texte
// "à compléter" si absentes — la ligne correspondante est simplement omise.
export interface Props {
  siteName: string;
  phone?: string;
  email?: string;
  address?: string;
  legalName?: string;
  facebook?: string;
}

const { siteName, phone, email, address, legalName, facebook } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-footer)] pt-12 pb-24 text-gray-300 lg:pb-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <p class="text-lg font-bold text-white">{siteName}</p>
        {address && <p class="mt-2 text-sm">{address}</p>}
      </div>
      <div class="text-sm md:text-right">
        {phone && <p><a href={`tel:${phone.replace(/\s+/g, '')}`} class="inline-flex items-center hover:text-white">{phone}</a></p>}
        {email && <p><a href={`mailto:${email}`} class="inline-flex items-center hover:text-white">{email}</a></p>}
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-gray-700 pt-6 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {legalName || siteName}. Tous droits réservés.</p>
      <div class="flex items-center gap-4">
        <a href="/mentions-legales" class="inline-flex items-center hover:text-gray-300">Mentions légales</a>
        <a href="/politique-de-confidentialite" class="inline-flex items-center hover:text-gray-300">Confidentialité</a>
        {facebook && (
          <a href={facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-gray-300" aria-label="Page Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.2 2.23.2v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12Z"/></svg>
            Facebook
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
