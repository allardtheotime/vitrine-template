---
// Coordonnées non fabricables (téléphone, email) : ne jamais afficher de texte
// "à compléter" si absentes — la ligne correspondante est simplement omise.
export interface Props {
  siteName: string;
  phone?: string;
  email?: string;
  address?: string;
  legalName?: string;
}

const { siteName, phone, email, address, legalName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 py-12 text-gray-300">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <p class="text-lg font-bold text-white">{siteName}</p>
        {address && <p class="mt-2 text-sm">{address}</p>}
      </div>
      <div class="text-sm md:text-right">
        {phone && <p><a href={`tel:${phone.replace(/\s+/g, '')}`} class="hover:text-white">{phone}</a></p>}
        {email && <p><a href={`mailto:${email}`} class="hover:text-white">{email}</a></p>}
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-gray-700 pt-6 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {legalName || siteName}. Tous droits réservés.</p>
      <a href="/mentions-legales" class="hover:text-gray-300">Mentions légales</a>
    </div>
  </div>
</footer>
