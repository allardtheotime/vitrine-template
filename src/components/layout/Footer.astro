---
interface Props {
  site: {
    name: string;
    phone: string;
    email: string;
    address: string;
    hours: string;
    siret: string;
    tagline: string;
  };
}

const { site } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Colonne 1 : Identité -->
      <div>
        <h2 class="text-white text-lg font-bold mb-3">{site.name}</h2>
        <p class="text-sm leading-relaxed">{site.tagline}</p>
      </div>

      <!-- Colonne 2 : Contact -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white transition-colors">
              {site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">
              {site.email}
            </a>
          </li>
          <li>{site.address}</li>
          <li>{site.hours}</li>
        </ul>
      </div>

      <!-- Colonne 3 : Liens utiles -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">Informations</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/mentions-legales" class="hover:text-white transition-colors">
              Mentions légales
            </a>
          </li>
          <li>
            <a href="#contact" class="hover:text-white transition-colors">
              Nous contacter
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bas de page -->
    <div class="mt-10 pt-6 border-t border-gray-700 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
      <p>&copy; {currentYear} {site.name}. Tous droits réservés.</p>
      <p>SIRET : {site.siret}</p>
    </div>
  </div>
</footer>
