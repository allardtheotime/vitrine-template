---
// Repli téléphone : le bouton "Appeler" n'apparaît, en desktop comme en mobile,
// que si `phone` est fourni — jamais de bouton vide en attendant.
export interface Props {
  siteName: string;
  logo?: string;
  links: { label: string; href: string }[];
  ctaText?: string;
  ctaHref?: string;
  phone?: string;
}

const { siteName, logo, links, ctaText, ctaHref = '/#contact', phone } = Astro.props;
---

<header class="sticky top-0 z-40 bg-[var(--color-surface)] shadow-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2">
      {logo ? (
        <img src={logo} alt={siteName} class="h-14 w-auto" />
      ) : (
        <span class="text-lg font-bold text-primary">{siteName}</span>
      )}
    </a>

    <ul class="hidden gap-6 lg:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="inline-flex items-center text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-primary">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-3 lg:flex">
      {phone && (
        <a
          href={`tel:${phone.replace(/\s+/g, '')}`}
          class="inline-flex items-center text-sm font-semibold text-[var(--color-text)] transition-colors hover:text-primary"
        >
          {phone}
        </a>
      )}
      {ctaText && (
        <a
          href={ctaHref}
          class="btn-press inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-focus)]"
        >
          {ctaText}
        </a>
      )}
    </div>

    <button
      id="mobile-menu-toggle"
      class="inline-flex min-w-[44px] items-center justify-center rounded-md p-2 text-[var(--color-text)] lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <ul id="mobile-menu" class="hidden flex-col gap-1 border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 lg:hidden">
    {links.map((link) => (
      <li>
        <a href={link.href} class="block rounded-md px-3 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:bg-[var(--color-bg)]">
          {link.label}
        </a>
      </li>
    ))}
    {phone && (
      <li>
        <a href={`tel:${phone.replace(/\s+/g, '')}`} class="flex items-center justify-center rounded-md border border-[var(--color-border)] px-3 py-3 text-sm font-semibold text-[var(--color-text)]">
          {phone}
        </a>
      </li>
    )}
    {ctaText && (
      <li>
        <a href={ctaHref} class="btn-press flex items-center justify-center rounded-md bg-primary px-3 py-3 text-sm font-semibold text-white">
          {ctaText}
        </a>
      </li>
    )}
  </ul>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Referme le menu après un clic sur n'importe quel lien à l'intérieur
  // (ancre de section, tel:, mailto:...) — sinon le menu reste ouvert
  // par-dessus le contenu même quand le lien a bien fait son effet.
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
