---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  phone: string;
  links?: NavLink[];
}

const { siteName, phone, links = [] } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / nom du site -->
      <a href="/" class="text-xl font-bold text-primary truncate">
        {siteName}
      </a>

      <!-- Navigation desktop -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Navigation principale">
        {links.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium text-gray-600 hover:text-primary transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA téléphone -->
      <a
        href={`tel:${phone.replace(/\s/g, '')}`}
        class="hidden sm:inline-flex items-center gap-2 btn-primary text-sm py-2 px-4"
        aria-label={`Appeler le ${phone}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {phone}
      </a>

      <!-- Menu burger mobile -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:text-primary hover:bg-gray-100 transition-colors"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-100 bg-white"
    aria-label="Menu mobile"
  >
    <nav class="flex flex-col px-4 py-3 gap-1">
      {links.map(link => (
        <a
          href={link.href}
          class="py-2 px-3 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`tel:${phone.replace(/\s/g, '')}`}
        class="mt-2 btn-primary text-sm text-center"
      >
        {phone}
      </a>
    </nav>
  </div>
</header>

<!-- Offset pour compenser la navbar fixe -->
<div class="h-16" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Fermer le menu au clic sur un lien
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
