---
// Icône Instagram en SVG inline : les logos de marque ne sont pas dans
// lucide-static. Même usage que Icon.astro (taille via `class`).
export interface Props {
  class?: string;
}
const { class: className = 'h-5 w-5' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" /></svg>
