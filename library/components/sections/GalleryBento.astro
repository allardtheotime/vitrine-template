---
// Variante de Gallery.astro (library) en mosaïque : la première photo occupe
// 2×2 cases, les suivantes 1 case (5 photos = grille pleine de 4 colonnes sur
// 2 rangées ; 2 colonnes sur mobile). Vraies photos uniquement, jamais de stock,
// rendue seulement si au moins une photo existe. Sans visionneuse : zéro JS.
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  images: { src?: string; srcset?: string; alt: string }[];
  facebook?: string;
  facebookLabel?: string;
}

const { title, subtitle, images = [], facebook, facebookLabel } = Astro.props;
---

<SectionWrapper id="galerie" bg="surface">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-[var(--color-text)]">{title}</h2>
    {subtitle && <p class="mt-3 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
  </div>

  <ul class="mt-10 grid auto-rows-[140px] grid-cols-2 gap-3 sm:auto-rows-[180px] sm:gap-4 md:auto-rows-[200px] md:grid-cols-4">
    {images.map((img, i) => (
      <li class={i === 0 ? 'col-span-2 row-span-2' : ''}>
        <figure class="group h-full overflow-hidden rounded-xl">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes={i === 0 ? '(min-width: 768px) 560px, 100vw' : '(min-width: 768px) 280px, 50vw'}
            alt={img.alt}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
          />
          <figcaption class="sr-only">{img.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>

  {facebook && facebookLabel && (
    <p class="mt-8 text-center">
      <a href={facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-semibold text-[var(--color-secondary)] underline decoration-primary decoration-2 underline-offset-4 hover:decoration-[var(--color-secondary)]">
        {facebookLabel}
      </a>
    </p>
  )}
</SectionWrapper>
