---
// Variante client de Contact.astro (DESIGN.md §Structure 9) : horaires détaillés
// en tableau, adresse + accès + itinéraire, téléphone cliquable, puis le même
// formulaire que Contact.astro (même champs anti-spam, même appel /api/contact).
// Repli email : aucune ligne email si la donnée est absente, le formulaire sert
// de canal écrit. `mapsUrl` (ex. fiche Google Maps, ajouté pour hair-family-arlon)
// est prioritaire sur la recherche Google Maps par adresse.
import PillButton from '../ui/PillButton.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  title?: string;
  intro?: string;
  access?: string;
  formTitle?: string;
  phone?: string;
  email?: string;
  address?: string;
  mapsUrl?: string;
  openingHours?: { day: string; hours: string; note?: string }[];
}

const { title = 'Contact', intro, access, formTitle, phone, email, address, mapsUrl: mapsLink, openingHours = [] } = Astro.props;
const tel = phone ? `tel:+32${phone.replace(/\s+/g, '').replace(/^0/, '')}` : undefined;
const mapsUrl = mapsLink || (address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}` : undefined);
---

<SectionWrapper id="contact" bg="surface">
  <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <h2 class="text-[var(--color-text)]">{title}</h2>
      {intro && <p class="mt-3 text-lg text-[var(--color-text-muted)]">{intro}</p>}

      {openingHours.length > 0 && (
        <table class="mt-8 w-full overflow-hidden rounded-xl border border-[var(--color-border)] text-left">
          <caption class="sr-only">Horaires d'ouverture</caption>
          <tbody>
            {openingHours.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-[var(--color-bg)]' : 'bg-[var(--color-surface)]'}>
                <th scope="row" class="px-4 py-3 font-semibold text-[var(--color-text)]">{row.day}</th>
                <td class="tabular px-4 py-3 text-right text-[var(--color-text)]">
                  {row.note && (
                    <span class="mr-2 inline-block rounded-full bg-[var(--color-secondary)] px-2 py-0.5 text-xs font-semibold text-primary">{row.note}</span>
                  )}
                  {row.hours}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <dl class="mt-8 space-y-4">
        {address && (
          <div class="flex items-start gap-3">
            <dt class="mt-0.5 text-[var(--color-secondary)]"><Icon name="map-pin" class="h-5 w-5" /><span class="sr-only">Adresse</span></dt>
            <dd>
              <p class="font-semibold text-[var(--color-text)]">{address}</p>
              {access && <p class="text-sm text-[var(--color-text-muted)]">{access}</p>}
            </dd>
          </div>
        )}
        {tel && (
          <div class="flex items-center gap-3">
            <dt class="text-[var(--color-secondary)]"><Icon name="phone" class="h-5 w-5" /><span class="sr-only">Téléphone</span></dt>
            <dd><a href={tel} class="inline-flex items-center font-semibold text-[var(--color-text)] underline decoration-primary decoration-2 underline-offset-4">{phone}</a></dd>
          </div>
        )}
        {email && (
          <div class="flex items-center gap-3">
            <dt class="text-[var(--color-secondary)]"><Icon name="mail" class="h-5 w-5" /><span class="sr-only">Email</span></dt>
            <dd><a href={`mailto:${email}`} class="inline-flex items-center font-semibold text-[var(--color-text)]">{email}</a></dd>
          </div>
        )}
      </dl>

      {mapsUrl && (
        <div class="mt-8">
          <PillButton href={mapsUrl} variant="outline-light" target="_blank" rel="noopener noreferrer">
            <Icon name="navigation" class="h-4 w-4" />
            Itinéraire
          </PillButton>
        </div>
      )}
    </div>

      <form id="contact-form" class="space-y-4 self-start rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 shadow-[var(--shadow-1)] sm:p-8" aria-labelledby="form-title">
        <!-- Anti-spam : champ piège invisible pour les humains, souvent rempli par les
             robots qui remplissent tous les champs sans exécuter le CSS — cf. api/contact.ts -->
        <div class="hidden" aria-hidden="true">
          <label for="company">Ne pas remplir ce champ</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" id="form-loaded-at" name="loaded_at" value="" />
        {formTitle && <h3 id="form-title" class="text-[var(--color-text)]">{formTitle}</h3>}
        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-text)]">Nom</label>
          <input
            id="name" name="name" type="text" required
            class="mt-1 w-full min-h-[48px] rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-text)] focus:border-primary"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-[var(--color-text)]">Email</label>
          <input
            id="email" name="email" type="email" required
            class="mt-1 w-full min-h-[48px] rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-text)] focus:border-primary"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-[var(--color-text)]">Message</label>
          <textarea
            id="message" name="message" required rows="4"
            class="mt-1 w-full min-h-[48px] rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-text)] focus:border-primary"
          ></textarea>
        </div>

        <PillButton type="submit" class="w-full">Envoyer</PillButton>

        <p id="contact-form-success" role="status" class="hidden rounded-lg bg-[var(--color-secondary)] px-4 py-3 text-sm text-[var(--color-on-dark)]">
          Message envoyé, merci — nous revenons vers vous rapidement.
        </p>
        <p id="contact-form-error" role="alert" class="hidden text-sm font-medium text-[var(--color-error)]">
          Une erreur est survenue, réessayez ou contactez-nous directement.
        </p>
      </form>
  </div>
</SectionWrapper>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('contact-form-success');
  const errorMsg = document.getElementById('contact-form-error');
  const loadedAtInput = document.getElementById('form-loaded-at') as HTMLInputElement | null;

  if (loadedAtInput) loadedAtInput.value = String(Date.now());

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form).entries());
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) throw new Error('request failed');

      successMsg?.classList.remove('hidden');
      form.reset();
    } catch {
      errorMsg?.classList.remove('hidden');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
