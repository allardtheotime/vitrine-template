---
// Section propre à ce client : traiteur et événements (plats sur commande,
// formules pour anniversaires et soirées, prêt de matériel). Cartes avec photo
// facultative, mention de conditions et appel à l'action vers le téléphone
// ou le formulaire de contact.
import SectionWrapper from '../ui/SectionWrapper.astro';
import PillButton from '../ui/PillButton.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  title: string;
  subtitle?: string;
  note?: string;
  ctaText?: string;
  phone?: string;
  items: { title: string; description?: string; image?: string; image_srcset?: string; image_alt?: string }[];
}

const { title, subtitle, note, ctaText, phone, items = [] } = Astro.props;
const tel = phone ? `tel:+32${phone.replace(/\s+/g, '').replace(/^0/, '')}` : undefined;
---

<SectionWrapper id="traiteur" bg="bg">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-[var(--color-text)]">{title}</h2>
    {subtitle && <p class="mt-3 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((it) => (
      <li class="flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-1)]">
        {it.image ? (
          <img
            src={it.image}
            srcset={it.image_srcset}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            alt={it.image_alt ?? ''}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
        ) : (
          <div class="flex aspect-[4/3] items-center justify-center bg-[var(--color-secondary)] text-primary">
            <Icon name="party-popper" class="h-12 w-12" />
          </div>
        )}
        <div class="flex-1 p-5">
          <h3 class="text-[var(--color-text)]">{it.title}</h3>
          {it.description && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{it.description}</p>}
        </div>
      </li>
    ))}
  </ul>

  {(note || ctaText) && (
    <div class="mt-10 flex flex-col items-center gap-4 text-center">
      {note && <p class="max-w-xl text-[var(--color-text-muted)]">{note}</p>}
      <div class="flex flex-col gap-3 sm:flex-row">
        {ctaText && <PillButton href="#contact">{ctaText}</PillButton>}
        {tel && (
          <PillButton href={tel} variant="outline-light">
            <Icon name="phone" class="h-4 w-4" />
            {phone}
          </PillButton>
        )}
      </div>
    </div>
  )}
</SectionWrapper>
