---
// Variante client de Testimonials.astro (DESIGN.md §Structure 8) : note globale
// réelle en tête, puis citations réelles. La note par citation est facultative :
// sans note, aucune étoile n'est affichée (on n'invente jamais de note).
import SectionWrapper from '../ui/SectionWrapper.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  title?: string;
  ratingValue?: string;
  ratingLabel?: string;
  items: { name: string; text: string; rating?: number; source?: string }[];
}

const { title, ratingValue, ratingLabel, items = [] } = Astro.props;
const numeric = ratingValue ? parseFloat(ratingValue.replace(',', '.')) : undefined;
const starFill = (i: number) => (numeric === undefined ? 0 : Math.max(0, Math.min(1, numeric - i)));
---

<SectionWrapper id="avis" bg="bg">
  <div class="text-center">
    {title && <h2 class="text-[var(--color-text)]">{title}</h2>}
    {ratingValue && (
      <div class="mt-6 flex flex-col items-center gap-2">
        <p class="font-display text-5xl font-bold text-[var(--color-secondary)]">
          {ratingValue}<span class="text-2xl text-[var(--color-text-muted)]"> / 5</span>
        </p>
        <div class="flex gap-1 text-primary" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => (
            <span class="relative inline-block h-6 w-6">
              <Icon name="star" class="absolute inset-0 h-6 w-6" />
              <span class="absolute inset-0 overflow-hidden" style={`width:${starFill(i) * 100}%`}>
                <Icon name="star" class="h-6 w-6 fill-current" />
              </span>
            </span>
          ))}
        </div>
        {ratingLabel && <p class="text-sm text-[var(--color-text-muted)]">{ratingLabel}</p>}
      </div>
    )}
  </div>

  {items.length > 0 && (
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {items.map((item) => (
        <li>
          <figure class="flex h-full flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-1)]">
            <Icon name="quote" class="h-8 w-8 text-primary" />
            {item.rating && (
              <p class="mt-3 flex gap-0.5 text-primary" aria-label={`Note : ${item.rating} sur 5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <Icon name="star" class={`h-4 w-4 ${i < item.rating! ? 'fill-current' : ''}`} />
                ))}
              </p>
            )}
            <blockquote class="mt-4 flex-1 font-display text-lg italic text-[var(--color-text)]">
              <p>{item.text}</p>
            </blockquote>
            <figcaption class="mt-5 text-sm">
              <span class="font-semibold text-[var(--color-text)]">{item.name}</span>
              {item.source && <span class="text-[var(--color-text-muted)]"> · {item.source}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )}
</SectionWrapper>
