---
// Variante client de About.astro (DESIGN.md §Structure 6) : photo principale +
// vignette d'archive en surimpression, chiffres clés en Playfair vert profond
// (l'or sur crème ne passe pas le contraste pour du texte, cf. DESIGN.md §2).
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  text: string;
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
  image2?: string;
  image2Alt?: string;
  image2Caption?: string;
  stats?: { value: string; label: string }[];
}

const { title, subtitle, text, image, imageSrcset, imageAlt, image2, image2Alt, image2Caption, stats = [] } = Astro.props;
---

<SectionWrapper id="histoire" bg="bg">
  <div class="grid items-center gap-12 md:grid-cols-12">
    {image && (
      <div class="relative md:col-span-5">
        <img
          src={image}
          srcset={imageSrcset}
          sizes="(min-width: 768px) 40vw, 100vw"
          alt={imageAlt ?? ''}
          loading="lazy"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-[var(--shadow-2)]"
        />
        {image2 && (
          <figure class="absolute -bottom-6 -right-3 w-36 rotate-3 rounded-lg bg-[var(--color-surface)] p-2 pb-1 shadow-[var(--shadow-2)] sm:w-44 md:-right-8">
            <img src={image2} alt={image2Alt ?? ''} loading="lazy" class="aspect-square w-full rounded object-cover" />
            {image2Caption && <figcaption class="py-1 text-center font-display text-sm italic text-[var(--color-text-muted)]">{image2Caption}</figcaption>}
          </figure>
        )}
      </div>
    )}

    <div class={image ? 'md:col-span-7 md:pl-6' : 'md:col-span-12'}>
      <h2 class="text-[var(--color-text)]">{title}</h2>
      {subtitle && <p class="mt-2 font-display text-lg italic text-[var(--color-text-muted)]">{subtitle}</p>}
      <p class="mt-5 max-w-prose text-[var(--color-text)]">{text}</p>

      {stats.length > 0 && (
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-[var(--color-border)] pt-6">
          {stats.map((stat) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 text-sm text-[var(--color-text-muted)]">{stat.label}</dt>
              <dd class="tabular font-display text-3xl font-bold text-[var(--color-secondary)]">{stat.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</SectionWrapper>
