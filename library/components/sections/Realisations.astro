---
// Section spécifique à ce projet (cf. DESIGN.md §Structure, point 6) — conditionnelle :
// n'est rendue que si `items` contient au moins un projet avec une photo réelle (jamais
// de visuel générique/stock en remplacement, cf. DESIGN.md §8 règle 4).
// Chaque projet peut contenir plusieurs photos : cliquer sur une vignette ouvre une
// visionneuse (lightbox) qui permet de parcourir les autres photos du même projet.
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  items: { title: string; images: { src: string; alt: string }[] }[];
  facebook?: string;
}

const { title, items, facebook } = Astro.props;
---

<SectionWrapper id="realisations" bg="surface">
  <h2 class="text-center text-[var(--color-text)]">{title}</h2>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((project, i) => (
      <button
        type="button"
        class="group overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-left shadow-[0_1px_3px_rgba(34,32,29,0.08)] transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_12px_rgba(34,32,29,0.12)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus)]"
        data-realisation-trigger
        data-index={i}
        aria-haspopup="dialog"
      >
        <img
          src={project.images[0].src}
          alt={project.images[0].alt}
          loading="lazy"
          class="aspect-[4/3] w-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
        <div class="p-3">
          <p class="text-sm font-medium text-[var(--color-text)]">{project.title}</p>
          {project.images.length > 1 && (
            <p class="mt-0.5 text-xs text-[var(--color-text-muted)]">{project.images.length} photos</p>
          )}
        </div>
      </button>
    ))}
  </div>

  {facebook && (
    <p class="mt-8 text-center">
      <a
        href={facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline"
      >
        Voir plus de réalisations sur Facebook
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </p>
  )}
</SectionWrapper>

<div
  id="realisation-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Galerie de réalisation"
>
  <button
    type="button"
    id="realisation-lightbox-close"
    class="absolute right-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
    aria-label="Fermer"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" /></svg>
  </button>
  <button
    type="button"
    id="realisation-lightbox-prev"
    class="absolute left-2 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white sm:left-4"
    aria-label="Photo précédente"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <button
    type="button"
    id="realisation-lightbox-next"
    class="absolute right-2 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white sm:right-4"
    aria-label="Photo suivante"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <figure class="max-h-full max-w-3xl">
    <img id="realisation-lightbox-img" src="" alt="" class="max-h-[75vh] w-full rounded-lg object-contain" />
    <figcaption id="realisation-lightbox-caption" class="mt-3 text-center text-sm text-white/80"></figcaption>
  </figure>
</div>

<script define:vars={{ projects: items }}>
  const lightbox = document.getElementById('realisation-lightbox');
  const imgEl = document.getElementById('realisation-lightbox-img');
  const captionEl = document.getElementById('realisation-lightbox-caption');
  const closeBtn = document.getElementById('realisation-lightbox-close');
  const prevBtn = document.getElementById('realisation-lightbox-prev');
  const nextBtn = document.getElementById('realisation-lightbox-next');

  let currentProject = 0;
  let currentImage = 0;

  function render() {
    const project = projects[currentProject];
    const image = project.images[currentImage];
    imgEl.src = image.src;
    imgEl.alt = image.alt;
    captionEl.textContent = `${project.title} (${currentImage + 1}/${project.images.length})`;
    const multi = project.images.length > 1;
    prevBtn.hidden = !multi;
    nextBtn.hidden = !multi;
  }

  function openLightbox(projectIndex) {
    currentProject = projectIndex;
    currentImage = 0;
    render();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-realisation-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => openLightbox(Number(btn.dataset.index)));
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  prevBtn.addEventListener('click', () => {
    const project = projects[currentProject];
    currentImage = (currentImage - 1 + project.images.length) % project.images.length;
    render();
  });
  nextBtn.addEventListener('click', () => {
    const project = projects[currentProject];
    currentImage = (currentImage + 1) % project.images.length;
    render();
  });
  document.addEventListener('keydown', (event) => {
    if (lightbox.classList.contains('hidden')) return;
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') prevBtn.click();
    if (event.key === 'ArrowRight') nextBtn.click();
  });
</script>
