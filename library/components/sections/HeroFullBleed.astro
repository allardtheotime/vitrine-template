---
// Section propre à ce client (DESIGN.md §Structure 2) : photo plein cadre avec
// dégradé sombre pour la lisibilité, sur-titre, nom géant, ligne de statut,
// sous-titre, badges, deux CTA. Image en chargement immédiat (above the fold).
import PillButton from '../ui/PillButton.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  status?: string;
  subtitle?: string;
  badges?: string[];
  ctaText?: string;
  ctaLink?: string;
  cta2Text?: string;
  cta2Link?: string;
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  status,
  subtitle,
  badges = [],
  ctaText,
  ctaLink = '#booking',
  cta2Text,
  cta2Link = '#dates',
  image,
  imageSrcset,
  imageAlt = '',
} = Astro.props;
---

<section class="relative isolate flex min-h-[calc(100svh-69px)] items-end overflow-hidden bg-[var(--color-bg)]">
  {image && (
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <img
        src={image}
        srcset={imageSrcset}
        sizes="100vw"
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        class="hero-zoom h-full w-full object-cover object-[60%_30%]"
      />
      <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_85%,transparent)_50%,color-mix(in_srgb,var(--color-bg)_30%,transparent)_75%,transparent_90%)] md:bg-[linear-gradient(to_top,var(--color-bg)_0%,color-mix(in_srgb,var(--color-bg)_70%,transparent)_40%,transparent_75%)]" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,color-mix(in_srgb,var(--color-bg)_75%,transparent)_0%,transparent_60%)]" aria-hidden="true"></div>
      <div class="absolute -left-40 top-1/3 h-[480px] w-[480px] rounded-full bg-[radial-gradient(circle,color-mix(in_srgb,var(--color-secondary)_20%,transparent)_0%,transparent_70%)]" aria-hidden="true"></div>
    </div>
  )}

  <div class="hero-fade mx-auto w-full max-w-[1200px] px-4 pb-14 pt-24 sm:px-6 md:pb-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display-xl mt-4 text-[var(--color-text)]">{title}</h1>
    {status && (
      <p class="mt-5 flex items-center gap-3 text-sm font-medium uppercase tracking-[0.12em] text-[var(--color-text)]">
        <span class="h-2 w-2 shrink-0 rounded-full bg-primary shadow-[var(--glow)]" aria-hidden="true"></span>
        {status}
      </p>
    )}
    {subtitle && <p class="mt-5 max-w-xl text-lg text-[var(--color-text-muted)] md:text-xl">{subtitle}</p>}

    {badges.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {badges.map((badge) => (
          <li class="rounded-full border border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_60%,transparent)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text)] backdrop-blur-sm">
            {badge}
          </li>
        ))}
      </ul>
    )}

    {(ctaText || cta2Text) && (
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {ctaText && <PillButton href={ctaLink} size="lg">{ctaText}</PillButton>}
        {cta2Text && <PillButton href={cta2Link} size="lg" variant="outline-light">{cta2Text}</PillButton>}
      </div>
    )}
  </div>
</section>
