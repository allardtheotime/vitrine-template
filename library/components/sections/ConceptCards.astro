---
// Variante client de Services.astro (DESIGN.md §Structure 4, §4) : cartes à
// icône or dans un cercle vert profond, fond crème, légère élévation au survol.
import SectionWrapper from '../ui/SectionWrapper.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  title: string;
  subtitle?: string;
  items: { icon: string; title: string; description: string }[];
}

const { title, subtitle, items } = Astro.props;
---

<SectionWrapper id="concept" bg="bg">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-[var(--color-text)]">{title}</h2>
    {subtitle && <p class="mt-3 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
  </div>

  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {items.map((item) => (
      <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 shadow-[var(--shadow-1)] transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-[var(--shadow-2)]">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-secondary)] text-primary">
          <Icon name={item.icon} class="h-7 w-7" />
        </span>
        <h3 class="mt-5 text-[var(--color-text)]">{item.title}</h3>
        <p class="mt-2 text-[var(--color-text-muted)]">{item.description}</p>
      </li>
    ))}
  </ol>
</SectionWrapper>
