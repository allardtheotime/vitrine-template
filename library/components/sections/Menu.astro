---
// Section propre à ce client (DESIGN.md §Structure 5, §4) : la carte en HTML
// structuré (jamais en image), sur fond vert profond. Rubriques avec prix
// unique en médaillons (ex. cornets classiques) ou prix à la ligne, puces
// d'ancre pour sauter d'une rubrique à l'autre. Zéro JS.
export interface Props {
  title: string;
  subtitle?: string;
  categories: {
    title: string;
    note?: string;
    footnote?: string;
    prices: { label: string; price: string }[];
    items: { name: string; description?: string; price?: string }[];
  }[];
  supplements?: string;
  allergyNote?: string;
}

const { title, subtitle, categories = [], supplements, allergyNote } = Astro.props;

const slug = (text: string) =>
  'carte-' +
  text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const shortLabel = (text: string) => text.replace(/^(les|nos)\s+/i, '').replace(/^\w/, (c) => c.toUpperCase());
---

<section id="carte" class="scroll-mt-20 bg-[var(--color-secondary)] py-16 text-[var(--color-on-dark)] md:py-24">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="text-center">
      <h2 class="text-[var(--color-on-dark)]">{title}</h2>
      <div class="tricolore mx-auto mt-4" aria-hidden="true"></div>
      {subtitle && <p class="mt-4 text-lg text-[var(--color-on-dark-muted)]">{subtitle}</p>}
    </div>

    {categories.length > 1 && (
      <nav class="mt-8" aria-label="Rubriques de la carte">
        <ul class="flex flex-wrap justify-center gap-2">
          {categories.map((cat) => (
            <li>
              <a
                href={`#${slug(cat.title)}`}
                class="inline-flex min-h-[44px] items-center rounded-full border border-primary px-4 text-sm font-medium text-[var(--color-on-dark)] transition-colors duration-200 hover:bg-primary hover:text-[var(--color-text)]"
              >
                {shortLabel(cat.title)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="mt-12 space-y-14">
      {categories.map((cat) => (
        <section id={slug(cat.title)} class="scroll-mt-24" aria-labelledby={`${slug(cat.title)}-titre`}>
          <div class="flex flex-col gap-4 border-b border-[color-mix(in_srgb,var(--color-primary)_40%,transparent)] pb-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h3 id={`${slug(cat.title)}-titre`} class="italic text-primary">{cat.title}</h3>
              {cat.note && <p class="mt-1 text-sm text-[var(--color-on-dark-muted)]">{cat.note}</p>}
            </div>
            {cat.prices.length > 0 && (
              <ul class="flex gap-3" aria-label="Prix de la rubrique">
                {cat.prices.map((p) => (
                  <li class="flex h-20 w-20 flex-col items-center justify-center rounded-full border-2 border-primary text-center">
                    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-on-dark-muted)]">{p.label}</span>
                    <span class="tabular font-display text-lg font-bold text-primary">{p.price}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <ul class="mt-6 grid gap-x-12 gap-y-5 md:grid-cols-2">
            {cat.items.map((item) => (
              <li>
                <div class="flex items-baseline gap-3">
                  <span class="font-display text-[1.05rem] font-semibold text-[var(--color-on-dark)]">{item.name}</span>
                  {item.price && (
                    <>
                      <span class="min-w-[1.5rem] flex-1 translate-y-[-0.2em] border-b border-dotted border-[color-mix(in_srgb,var(--color-primary)_45%,transparent)]" aria-hidden="true"></span>
                      <span class="tabular shrink-0 whitespace-nowrap font-semibold text-primary">{item.price}</span>
                    </>
                  )}
                </div>
                {item.description && <p class="mt-0.5 text-sm text-[var(--color-on-dark-muted)]">{item.description}</p>}
              </li>
            ))}
          </ul>

          {cat.footnote && <p class="mt-5 text-sm italic text-[var(--color-on-dark-muted)]">{cat.footnote}</p>}
        </section>
      ))}
    </div>

    {(supplements || allergyNote) && (
      <div class="mt-14 space-y-2 border-t border-[color-mix(in_srgb,var(--color-primary)_40%,transparent)] pt-6 text-center text-sm">
        {supplements && <p class="text-[var(--color-on-dark-muted)]">{supplements}</p>}
        {allergyNote && <p class="font-semibold text-primary">{allergyNote}</p>}
      </div>
    )}
  </div>
</section>
