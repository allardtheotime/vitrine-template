---
// Variante de HeroSplit.astro (library) pour un commerce sans rendez-vous
// (DESIGN.md §Structure 2) : second bouton libre (ex. « Itinéraire » vers
// Google Maps, nouvel onglet si lien externe), badges à icône neutre, ligne
// d'horaires + statut « Ouvert / Fermé » calculé dans le navigateur à partir des
// horaires détaillés (heure de Bruxelles). Sans JavaScript, seule la ligne
// d'horaires statique s'affiche : rien de vide ni de faux.
// Photo en carte au ratio d'origine (3:2), jamais étirée sur toute la hauteur :
// une photo de 1200 px reste nette même sur écran Retina (cas vécu : la
// version pleine hauteur de HeroSplit agrandissait l'image et la rendait floue).
import PillButton from '../ui/PillButton.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  cta2Text?: string;
  cta2Link?: string;
  hoursLine?: string;
  openingHours?: { day: string; hours: string }[];
  badges?: string[];
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  ctaText,
  ctaLink = '#carte',
  cta2Text,
  cta2Link,
  hoursLine,
  openingHours = [],
  badges = [],
  image,
  imageSrcset,
  imageAlt,
} = Astro.props;
const external = (href?: string) => (href && /^https?:/.test(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<section class="relative overflow-hidden bg-[var(--color-secondary)] text-[var(--color-on-dark)]">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-8 md:grid-cols-12 md:gap-8 md:py-20 lg:px-8">
    {image && (
      <div class="relative md:order-2 md:col-span-6">
        <div class="absolute -bottom-3 -right-3 hidden h-full w-full rounded-2xl border-2 border-primary md:block" aria-hidden="true"></div>
        <img
          src={image}
          srcset={imageSrcset}
          sizes="(min-width: 1024px) 560px, (min-width: 768px) 46vw, calc(100vw - 2.5rem)"
          alt={imageAlt ?? ''}
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-[3/2] w-full rounded-2xl object-cover shadow-[var(--shadow-2)]"
        />
      </div>
    )}

    <div class="md:order-1 md:col-span-6">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-4 text-[var(--color-on-dark)] [text-wrap:balance]">{title}</h1>
      {subtitle && <p class="mt-5 max-w-md text-lg text-[var(--color-on-dark-muted)]">{subtitle}</p>}

      {hoursLine && (
        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-on-dark)]">
          <span class="inline-flex items-center gap-2">
            <Icon name="clock" class="h-4 w-4 text-primary" />
            {hoursLine}
          </span>
          <span id="hero-status" class="hidden items-center gap-2 font-semibold" aria-live="polite" data-hours={JSON.stringify(openingHours)}>
            <span id="hero-status-dot" class="inline-block h-2.5 w-2.5 rounded-full"></span>
            <span id="hero-status-text"></span>
          </span>
        </p>
      )}

      {badges.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {badges.map((badge) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-primary px-3 py-1 text-sm text-[var(--color-on-dark)]">
              <Icon name="check" class="h-4 w-4 text-primary" />
              {badge}
            </li>
          ))}
        </ul>
      )}

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {ctaText && <PillButton href={ctaLink} size="lg" {...external(ctaLink)}>{ctaText}</PillButton>}
        {cta2Text && cta2Link && (
          <PillButton href={cta2Link} variant="outline-dark" size="lg" {...external(cta2Link)}>
            <Icon name="navigation" class="h-5 w-5" />
            {cta2Text}
          </PillButton>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  // Statut d'ouverture, heure de Bruxelles. Lignes attendues du lundi au
  // dimanche, au format « 9h – 19h », « 9h30 – 18h » ou « Fermé ».
  const el = document.getElementById('hero-status');
  const rows: { day: string; hours: string }[] = JSON.parse(el?.dataset.hours || '[]');
  const parse = (h: string) => {
    const m = h.match(/(\d{1,2})h(\d{2})?\s*[–-]\s*(\d{1,2})h(\d{2})?/);
    return m ? { open: +m[1] * 60 + +(m[2] || 0), close: +m[3] * 60 + +(m[4] || 0), closeLabel: `${m[3]}h${m[4] || ''}`, openLabel: `${m[1]}h${m[2] || ''}` } : null;
  };
  if (el && rows.length === 7) {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Brussels', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value || '';
    const idx = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(get('weekday'));
    const now = +get('hour') * 60 + +get('minute');
    const today = parse(rows[idx]?.hours || '');
    let text = '';
    let open = false;
    if (today && now >= today.open && now < today.close) {
      open = true;
      text = `Ouvert · ferme à ${today.closeLabel}`;
    } else {
      for (let k = 0; k < 7; k++) {
        const d = (idx + k) % 7;
        const slot = parse(rows[d].hours);
        if (!slot || (k === 0 && now >= slot.open)) continue;
        const when = k === 0 ? "aujourd'hui" : k === 1 ? 'demain' : rows[d].day.toLowerCase();
        text = `Fermé · ouvre ${when} à ${slot.openLabel}`;
        break;
      }
    }
    if (text) {
      document.getElementById('hero-status-text')!.textContent = text;
      document.getElementById('hero-status-dot')!.style.background = open ? 'var(--color-primary)' : 'var(--color-on-dark-muted)';
      el.classList.remove('hidden');
      el.classList.add('inline-flex');
    }
  }
</script>
