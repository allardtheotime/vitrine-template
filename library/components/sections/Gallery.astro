---
// Section propre à ce client (DESIGN.md §Structure 7) : galerie de vraies photos
// (plats, équipe), vignettes carrées, zoom léger au survol. Conditionnelle :
// la page ne la rend que si au moins une photo existe (jamais de stock).
// Pas de visionneuse : zéro JS (règle CLAUDE.md §11).
import SectionWrapper from '../ui/SectionWrapper.astro';

export interface Props {
  title: string;
  subtitle?: string;
  images: { src?: string; srcset?: string; alt: string }[];
  facebook?: string;
  facebookLabel?: string;
}

const { title, subtitle, images = [], facebook, facebookLabel } = Astro.props;
---

<SectionWrapper id="cuisine" bg="surface">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-[var(--color-text)]">{title}</h2>
    {subtitle && <p class="mt-3 text-lg text-[var(--color-text-muted)]">{subtitle}</p>}
  </div>

  <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
    {images.map((img) => (
      <li>
        <figure class="group overflow-hidden rounded-xl">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
            alt={img.alt}
            loading="lazy"
            class="aspect-square w-full object-cover transition-transform duration-200 group-hover:scale-[1.03]"
          />
          <figcaption class="sr-only">{img.alt}</figcaption>
        </figure>
      </li>
    ))}
  </ul>

  {facebook && facebookLabel && (
    <p class="mt-8 text-center">
      <a href={facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-semibold text-[var(--color-secondary)] underline decoration-primary decoration-2 underline-offset-4 hover:decoration-[var(--color-secondary)]">
        {facebookLabel}
      </a>
    </p>
  )}
</SectionWrapper>
