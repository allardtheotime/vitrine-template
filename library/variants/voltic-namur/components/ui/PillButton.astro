---
// Variante client de Button.astro (reprise de library/PillButton, DESIGN.md §4) :
// pilule. `primary` = fond rouge, texte blanc (≈ 5:1), halo rouge au survol ;
// `outline-light` = contour clair sur fond sombre ; `outline-dark` = contour
// discret (bordure du thème).
export interface Props {
  variant?: 'primary' | 'outline-dark' | 'outline-light';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const sizes = {
  sm: 'min-h-[44px] px-4 py-2 text-sm',
  md: 'min-h-[48px] px-7 py-3 text-base',
  lg: 'min-h-[52px] px-8 py-3.5 text-base',
};

const variants = {
  primary: 'bg-primary text-white hover:bg-[var(--color-primary-hover)] hover:shadow-[var(--glow)]',
  'outline-dark': 'border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-secondary)]',
  'outline-light': 'border-[1.5px] border-[var(--color-text)] text-[var(--color-text)] hover:bg-[color-mix(in_srgb,var(--color-text)_8%,transparent)]',
};

const base = 'btn-press inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-[background-color,box-shadow,border-color] duration-200 disabled:cursor-not-allowed disabled:opacity-50';
const classes = [base, sizes[size], variants[variant], className].join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
