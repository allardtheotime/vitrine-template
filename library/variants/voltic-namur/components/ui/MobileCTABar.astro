---
// Composant client (detongre-construction-virton, lilot-pates-namur), adapté ici :
// barre fixe en bas d'écran, mobile/tablette uniquement (masquée dès lg). Repli
// téléphone : sans numéro, le second bouton mène à Instagram au lieu d'« Appeler ».
import Icon from './Icon.astro';
import InstagramIcon from './InstagramIcon.astro';

export interface Props {
  ctaText: string;
  ctaHref?: string;
  phone?: string;
  instagram?: string;
  instagramLabel?: string;
}

const { ctaText, ctaHref = '#booking', phone, instagram, instagramLabel = 'Instagram' } = Astro.props;
const tel = phone ? `tel:+32${phone.replace(/\s+/g, '').replace(/^0/, '')}` : undefined;
const secondary = 'btn-press flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-full border border-[var(--color-border)] px-4 text-sm font-semibold text-[var(--color-text)]';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_92%,transparent)] p-3 backdrop-blur-md lg:hidden">
  {tel ? (
    <a href={tel} class={secondary}>
      <Icon name="phone" class="h-4 w-4" />
      {phone}
    </a>
  ) : instagram && (
    <a href={instagram} target="_blank" rel="noopener noreferrer" class={secondary} aria-label={`${instagramLabel} (nouvel onglet)`}>
      <InstagramIcon class="h-4 w-4" />
      Instagram
    </a>
  )}
  <a
    href={ctaHref}
    class="btn-press flex min-h-[48px] flex-1 items-center justify-center gap-2 rounded-full bg-primary px-4 text-sm font-semibold text-white hover:bg-[var(--color-primary-hover)]"
  >
    <Icon name="calendar-days" class="h-4 w-4" />
    {ctaText}
  </a>
</div>
