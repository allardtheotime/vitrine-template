---
// Variante d'About.astro (reprise de library/AboutStory, DESIGN.md §Structure 6) :
// photo principale 4/5 + vignette d'archive en surimpression légendée, chiffres
// clés en police d'affichage rouge lisible (--color-primary-text).
import SectionWrapper from '../ui/SectionWrapper.astro';
import SectionHeading from '../ui/SectionHeading.astro';

export interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  text: string;
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
  image2?: string;
  image2Alt?: string;
  image2Caption?: string;
  stats?: { value: string; label: string }[];
}

const { number, eyebrow, title, subtitle, text, image, imageSrcset, imageAlt, image2, image2Alt, image2Caption, stats = [] } = Astro.props;
const paragraphs = text.split(/\n\s*\n/).filter(Boolean);
---

<SectionWrapper id="histoire" bg="bg">
  <div class="reveal grid items-center gap-14 md:grid-cols-12">
    {image && (
      <div class="relative mr-6 md:col-span-5 md:mr-0">
        <img
          src={image}
          srcset={imageSrcset}
          sizes="(min-width: 768px) 40vw, 100vw"
          alt={imageAlt ?? ''}
          loading="lazy"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-[var(--shadow-1)]"
        />
        {image2 && (
          <figure class="absolute -bottom-8 -right-6 w-40 -rotate-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-2 pb-1 shadow-[var(--shadow-1)] sm:w-48 md:-right-10">
            <img src={image2} alt={image2Alt ?? ''} loading="lazy" class="aspect-[4/3] w-full rounded object-cover" />
            {image2Caption && <figcaption class="py-1.5 text-center text-xs text-[var(--color-text-muted)]">{image2Caption}</figcaption>}
          </figure>
        )}
      </div>
    )}

    <div class={image ? 'md:col-span-7 md:pl-8' : 'md:col-span-12'}>
      <SectionHeading number={number} eyebrow={eyebrow} title={title} subtitle={subtitle} />
      <div class="mt-6 max-w-prose space-y-4 text-[var(--color-text)]">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      {stats.length > 0 && (
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-[var(--color-border)] pt-6">
          {stats.map((stat) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 text-sm text-[var(--color-text-muted)]">{stat.label}</dt>
              <dd class="tabular font-display text-3xl font-semibold text-[var(--color-primary-text)] sm:text-4xl">{stat.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</SectionWrapper>
