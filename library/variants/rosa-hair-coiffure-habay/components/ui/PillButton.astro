---
// Variante client de Button.astro (DESIGN.md §4) : pilule, texte foncé sur l'or (jamais de blanc
// sur or, contraste insuffisant). `outline-dark` = contour or sur fond sombre,
// `outline-light` = contour or sur fond clair.
export interface Props {
  variant?: 'primary' | 'outline-dark' | 'outline-light';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const sizes = {
  sm: 'min-h-[44px] px-4 py-2 text-sm',
  md: 'min-h-[48px] px-6 py-3 text-base',
  lg: 'min-h-[52px] px-7 py-3.5 text-base',
};

const variants = {
  primary: 'bg-primary text-white hover:bg-[var(--color-primary-hover)]',
  'outline-dark': 'border-[1.5px] border-primary-light text-[var(--color-on-dark)] hover:bg-[color-mix(in_srgb,var(--color-primary-light)_15%,transparent)]',
  'outline-light': 'border-[1.5px] border-primary text-[var(--color-text)] hover:bg-[color-mix(in_srgb,var(--color-primary)_15%,transparent)]',
};

const base = 'btn-press inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-200 disabled:cursor-not-allowed disabled:opacity-55';
const classes = [base, sizes[size], variants[variant], className].join(' ');
---

{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
