---
// Section propre à ce client (DESIGN.md §Structure 5) : mise en avant d'une
// offre phare (ici le soin signature). Photo à gauche (au-dessus sur mobile),
// surtitre, titre, texte, liste de ce qui est compris, prix + précision, CTA.
// Réutilisable pour tout commerce qui veut pousser une prestation ou un produit.
// Rendue seulement si un titre est fourni (contrôlé par la page via `visible`).
import PillButton from '../ui/PillButton.astro';
import SectionWrapper from '../ui/SectionWrapper.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  text?: string;
  items?: string[];
  price?: string;
  priceNote?: string;
  ctaText?: string;
  ctaLink?: string;
  image?: string;
  imageSrcset?: string;
  imageAlt?: string;
}

const {
  id = 'offre',
  eyebrow,
  title,
  text,
  items = [],
  price,
  priceNote,
  ctaText,
  ctaLink = '#contact',
  image,
  imageSrcset,
  imageAlt,
} = Astro.props;
---

<SectionWrapper id={id} bg="surface" class="scroll-mt-20">
  <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
    {image && (
      <img
        src={image}
        srcset={imageSrcset}
        sizes="(min-width: 768px) 45vw, 100vw"
        alt={imageAlt ?? ''}
        loading="lazy"
        class="aspect-[4/5] w-full rounded-2xl object-cover shadow-[var(--shadow-2)] md:max-h-[640px]"
      />
    )}

    <div class={image ? '' : 'md:col-span-2'}>
      {eyebrow && <p class="eyebrow eyebrow-on-light">{eyebrow}</p>}
      <h2 class="mt-3 text-[var(--color-text)]">{title}</h2>
      {text && <p class="mt-4 max-w-prose text-lg text-[var(--color-text-muted)]">{text}</p>}

      {items.length > 0 && (
        <ul class="mt-6 space-y-3">
          {items.map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-text)]">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-secondary)] text-primary-light">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}

      {(price || ctaText) && (
        <div class="mt-8 flex flex-col gap-5 border-t border-[var(--color-border)] pt-6 sm:flex-row sm:items-center sm:justify-between">
          {price && (
            <p class="flex flex-col">
              <span class="tabular font-display text-4xl font-bold text-[var(--color-text)]">{price}</span>
              {priceNote && <span class="text-sm text-[var(--color-text-muted)]">{priceNote}</span>}
            </p>
          )}
          {ctaText && <PillButton href={ctaLink} size="lg">{ctaText}</PillButton>}
        </div>
      )}
    </div>
  </div>
</SectionWrapper>
